---
import '../styles/global.css'

import AppBar from '../components/AppBar.astro'
import MetaHead from '../components/MetaHead.astro'

// Accept metadata properties
export interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  url?: string
}

const { title, description, keywords, ogImage, url } = Astro.props
---

<!doctype html>
<html lang="en">
  <MetaHead
    title={title}
    description={description}
    keywords={keywords}
    ogImage={ogImage}
    url={url}
  />
  <body class="background">
    <div class="layout-container">
      <AppBar />
      <main id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  layout-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    display:flex
    flex-direction: column;
    flex: 1;
  }
</style>
