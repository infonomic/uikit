---
import '../styles/global.css'

import MetaHead from '../components/MetaHead.astro'

// Accept metadata properties
export interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  url?: string
}

const { title, description, keywords, ogImage, url } = Astro.props
---

<!doctype html>
<html lang="en">
  <MetaHead
    title={title}
    description={description}
    keywords={keywords}
    ogImage={ogImage}
    url={url}
  />
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
