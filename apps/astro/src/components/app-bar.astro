---
import { Hamburger } from '../../../../packages/uikit/src/astro'

import ThemeToggle from './theme-toggle.astro'
---

<header>
  <div class="main-menu">
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/components">Components</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>
  <div class="theme-toggle">
    <ThemeToggle />
  </div>
  <Hamburger open={false} />
</header>

<style>
  header {
    position: sticky;
    display: flex;
    align-items: center;
    justify-content: end;
    gap: var(--gap-4);
    top: 0;
    z-index: 20;
    width: 100%;
    background-color: var(--theme-500);
    color: white;
    padding: 0 1rem;
  }

  nav ul {
    display: flex;
    justify-content: end;
    gap: var(--gap-4);
    list-style: none;
  }
  nav ul li {
    margin: 0;
  }
  nav ul li a {
    display: block;
    padding: 1rem;
    color: white;
    text-decoration: none;
  }
</style>
