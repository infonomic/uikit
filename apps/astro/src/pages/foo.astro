---
import { Container, Section } from '@infonomic/uikit/astro'
import Welcome from '../components/Welcome.astro'
import Layout from '../layouts/Layout.astro'

// Page-specific metadata
const meta = {
  title: 'Foo',
  description: 'Description for the home page.',
  keywords: 'home, astro, web development',
  ogImage: '/home-og-image.png',
  url: 'https://yourwebsite.com/home'
}
---

<Layout {...meta}>
  <Section>
    <Container>
      <Welcome />
    </Container>
  </Section>
  <Section>
    <Container>
      <h2>Foo</h2>
      <p>This is the Foo page. It's a great page.</p>
    </Container>
  </Section>
</Layout>
