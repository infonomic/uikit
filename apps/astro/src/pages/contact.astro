---
import {
  Button,
  CloseIcon,
  Container,
  Input,
  InputAdornment,
  SearchIcon,
  Section
} from '@infonomic/uikit/astro'

import Layout from '../layouts/layout.astro'

// Page-specific metadata
const meta = {
  title: 'Contact',
  description: 'Description for the home page.',
  keywords: 'home, astro, web development',
  ogImage: '/home-og-image.png',
  url: 'https://yourwebsite.com/home'
}
---

<Layout {...meta}>
  <Section>
    <Container class="prose">
      <h1>Contact</h1>
      <p>This is the contact page. It's a great page.</p>
      <a href="/">Go to Home</a>
    </Container>
  </Section>
  <Section>
    <Container class="prose">
      <div class="contact-form not-prose">
        <form action="/contact" method="post">
          <div class="form-control">
            <Input
              label="Regular Input"
              helpText="Please enter text."
              placeHolder="Text here..."
              id="regular"
              name="regular"
              required
            />
          </div>
          <div class="form-control">
            <Input
              startAdornment={true}
              endAdornment={true}
              label="Input with Adornments"
              helpText="Please enter a text."
              placeHolder="Text here.."
              id="adornments"
              name="adornments"
              required
            >
              <InputAdornment position="start" slot="start-adornment">
                <SearchIcon />
              </InputAdornment>
              <InputAdornment position="end" slot="end-adornment">
                <CloseIcon height="18px" width="18px" />
              </InputAdornment>
            </Input>
          </div>
          <div class="form-control">
            <Input
              label="Error Input"
              helpText="Please enter text."
              error={true}
              errorText="This is an error message."
              placeHolder="Text here..."
              id="regular"
              name="regular"
              required
            />
          </div>
          <div class="form-actions">
            <Button type="submit">Submit</Button>
          </div>
        </form>
      </div>
    </Container>
  </Section>

  <style>
    section {
      padding: 1rem 0;
    }

    .contact-form {
      max-width: 600px;
      margin: 0 auto;
    }

    .form-control {
      margin: 0.5rem 0;
    }

    .form-actions {
      display: flex;
      gap: var(--gap-2);
      margin: 2rem 0 1rem;
    }
  </style>
</Layout>
