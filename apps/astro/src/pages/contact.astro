---
import {
  Button,
  CloseIcon,
  Container,
  Input,
  InputAdornment,
  SearchIcon,
  Section
} from '../../../../packages/uikit/src/astro'

import Layout from '../layouts/Layout.astro'

// Page-specific metadata
const meta = {
  title: 'Contact',
  description: 'Description for the home page.',
  keywords: 'home, astro, web development',
  ogImage: '/home-og-image.png',
  url: 'https://yourwebsite.com/home'
}
---

<Layout {...meta}>
  <Section>
    <Container className="prose">
      <h2>Contact</h2>
      <p>This is the contact page. It's a great page.</p>
      <a href="/">Go to Home</a>
    </Container>
  </Section>
  <Section>
    <Container className="prose">
      <div class="contact-form not-prose">
        <form action="/contact" method="post">
          <Input
            startAdornment={true}
            endAdornment={true}
            label="Message"
            helpText="Please enter a message."
            placeHolder="Message"
            id="message"
            name="message"
            required
          >
            <InputAdornment position="start" slot="start-adornment">
              <SearchIcon />
            </InputAdornment>
            <InputAdornment position="end" slot="end-adornment">
              <CloseIcon height="18px" width="18px" />
            </InputAdornment>
          </Input>
          <div class="form-actions">
            <Button type="submit">Submit</Button>
          </div>
        </form>
      </div>
    </Container>
  </Section>

  <style>
    .contact-form {
      max-width: 600px;
      margin: 0 auto;
    }
    .form-actions {
      display: flex;
      gap: var(--gap-2);
      margin: 1rem 0;
    }
  </style>
</Layout>
