---
import { Container, Section } from '../../../../packages/uikit/src/astro'
import Welcome from '../components/Welcome.astro'
import Layout from '../layouts/Layout.astro'

// Page-specific metadata
const meta = {
  title: 'Contact',
  description: 'Description for the home page.',
  keywords: 'home, astro, web development',
  ogImage: '/home-og-image.png',
  url: 'https://yourwebsite.com/home'
}
---

<Layout {...meta}>
  <Section>
    <Container className="prose">
      <h2>Contact</h2>
      <p>This is the contact page. It's a great page.</p>
      <a href="/">Go to Home</a>
    </Container>
  </Section>
</Layout>
