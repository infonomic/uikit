---
import {
  Button,
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
  Container,
  Section
} from '../../../../packages/uikit/src/astro'

import Layout from '../layouts/layout.astro'

// Page-specific metadata
const meta = {
  title: 'Components',
  description: 'Description for the components page.',
  keywords: 'home, astro, web development',
  ogImage: '/home-og-image.png',
  url: 'https://yourwebsite.com/components'
}
---

<Layout {...meta}>
  <Section>
    <Container class="prose">
      <h1>Components</h1>
      <p>This is the Components page. It's a great page.</p>
      <a href="/">Go to Home</a>
    </Container>
  </Section>
  <Section>
    <Container class="prose">
      <div class="grid not-prose">
        <Card>
          <CardHeader>
            <CardTitle>Regular Card</CardTitle>
            <CardDescription>
              This is a card description. It's a great description.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <p>Here is some card content here. And some even longer content here.</p>
          </CardContent>
          <CardFooter>
            <Button>Click Me</Button>
          </CardFooter>
        </Card>
        <Card>
          <CardHeader>
            <CardTitle>Regular Card</CardTitle>
            <CardDescription>
              This is a card description. It's a great description.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <p>Here is some card content here.</p>
          </CardContent>
          <CardFooter>
            <Button>Click Me</Button>
          </CardFooter>
        </Card>
        <Card href="/" hover={true}>
          <CardHeader>
            <CardTitle>Hover Card</CardTitle>
            <CardDescription>
              This is a card description. It's a great description.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <p>This card is actually a hyperlink with an href and hover enabled.</p>
          </CardContent>
          <CardFooter>
            <Button variant="filled">Click to Go Home</Button>
          </CardFooter>
        </Card>
      </div>
    </Container>
  </Section>
</Layout>

<style>
  section {
    padding: 1rem 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
</style>
