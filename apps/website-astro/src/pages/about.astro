---
import { Container, Section } from '@infonomic/uikit/astro'
import Layout from '../layouts/layout.astro'

// Page-specific metadata
const meta = {
  title: 'About',
  description: 'Description for the home page.',
  keywords: 'home, astro, web development',
  ogImage: '/home-og-image.png',
  url: 'https://yourwebsite.com/home'
}
---

<Layout {...meta}>
  <Section>
    <Container class="prose">
      <h1>About</h1>
      <p>This is the about page. It's a great page.</p>
      <a href="/">Go to Home</a>
    </Container>
  </Section>
</Layout>

<style>
  section {
    padding: 1rem 0;
  }
</style>
