---
import type { HTMLAttributes } from 'astro/types'
import type { Intent, Size, Variant } from './types/button.js'

interface Props extends HTMLAttributes<'button'>, Omit<HTMLAttributes<'a'>, 'type'> {
  variant?: Variant
  size?: Size
  type?: 'submit' | 'reset' | 'button'
  intent?: Intent
  fullWidth?: boolean
  ripple?: boolean
  class?: string
  as?: 'button' | 'a'
}

// import Ripple from 'material-ripple-effects' // Commented out as this is React specific
import styles from './button.module.css'

const {
  variant = 'filled',
  size = 'md',
  type = 'button',
  intent = 'primary',
  fullWidth = false,
  ripple = true,
  class: className,
  as = 'button',
  ...rest
} = Astro.props as Props

// let onMouseDown: (e: MouseEvent) => void | undefined
// if (ripple === true) {
//   const rippleEffect = new Ripple()
//   onMouseDown = (e: MouseEvent) => {
//     rippleEffect.create(e, variant === 'filled' || variant === 'gradient' ? 'light' : 'dark')
//   }
// }
---

{
  as === 'button' ? (
    <button
      type={type}
      class:list={[
        styles.button,
        styles[variant],
        styles[size],
        styles[intent],
        { [styles.fullWidth]: fullWidth },
        className
      ]}
      {...rest}
    >
      <slot />
    </button>
  ) : (
    <a
      class:list={[
        styles.button,
        styles[variant],
        styles[size],
        styles[intent],
        { [styles.fullWidth]: fullWidth },
        className
      ]}
      {...rest}
    >
      <slot />
    </a>
  )
}
