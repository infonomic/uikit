{
  "name": "@infonomic/uikit",
  "private": false,
  "license": "MIT",
  "version": "6.9.1",
  "type": "module",
  "description": "Infonomic UI kit is a collection of reusable UI components and utilities for React and Astro.",
  "keywords": [
    "uikit",
    "design system"
  ],
  "homepage": "https://github.com/infonomic/uikit",
  "bugs": {
    "url": "https://github.com/infonomic/uikit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/uikit.git",
    "directory": "packages/uikit"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "skip:astro-compose": "node ./scripts/build-astro.js",
    "dev:css": "node ./scripts/task-watch-css.js",
    "skip:css": "lightningcss --sourcemap --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "dev:code": "rslib build --watch",
    "build": "run-s build:*",
    "build:clean": "rimraf dist build",
    "build:code": "rslib build",
    "build:astro": "node ./scripts/build-astro.js",
    "build:css": "lightningcss --bundle ./src/styles/reset.css ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "build:minify": "lightningcss --minify ./dist/styles/reset.css ./dist/styles/styles.css ./dist/styles/typography.css --output-dir ./dist/styles",
    "build:vanilla-components-css": "node ./scripts/task-merge-vanilla-components-css.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf node_modules dist build types .turbo",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "node --test tests/*.test.mjs",
    "test:css-build": "CSS_BUILD_CHECK=1 node --test tests/*.test.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/react.d.ts",
  "module": "./dist/react.js",
  "main": "./dist/react.js",
  "files": [
    "dist/",
    "src/"
  ],
  "exports": {
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "default": "./dist/astro.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "main": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./reset.css": {
      "import": "./dist/styles/reset.css",
      "default": "./dist/styles/reset.css"
    },
    "./styles.css": {
      "import": "./dist/styles/styles.css",
      "default": "./dist/styles/styles.css"
    },
    "./typography.css": {
      "import": "./dist/styles/typography.css",
      "default": "./dist/styles/typography.css"
    },
    "./components.css": {
      "import": "./dist/styles/components-vanilla.css",
      "default": "./dist/styles/components-vanilla.css"
    },
    "./css-layers": {
      "types": "./dist/css-layers.d.ts",
      "import": "./dist/css-layers.js",
      "default": "./dist/css-layers.js"
    }
  },
  "peerDependencies": {
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "motion": "^14.14.0",
    "npm-run-all": "^4.1.5",
    "prism-react-renderer": "^2.4.1",
    "react-day-picker": "^10.0.2",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/node": "11.1.14",
    "@biomejs/biome": "2.6.8",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.7",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "astro": "7.4.13",
    "chokidar": "^6.0.0",
    "eslint-plugin-storybook": "^10.6.7",
    "lightningcss": "^1.33.0",
    "lightningcss-cli": "^1.33.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "storybook": "^10.6.7",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "^5.3.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "files": [
      "dist/",
      "src/"
    ]
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    }
  }
}
