{
  "name": "@infonomic/uikit",
  "private": false,
  "license": "MIT",
  "version": "6.7.7",
  "type": "module",
  "description": "Infonomic UI kit is a collection of reusable UI components and utilities for React and Astro.",
  "keywords": [
    "uikit",
    "design system"
  ],
  "homepage": "https://github.com/infonomic/uikit",
  "bugs": {
    "url": "https://github.com/infonomic/uikit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/uikit.git",
    "directory": "packages/uikit"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "skip:astro-compose": "node ./scripts/build-astro.js",
    "dev:css": "node ./scripts/task-watch-css.js",
    "skip:css": "lightningcss --sourcemap --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "dev:code": "rslib build --watch",
    "build": "run-s build:*",
    "build:clean": "rimraf dist build",
    "build:code": "rslib build",
    "build:astro": "node ./scripts/build-astro.js",
    "build:css": "lightningcss --bundle ./src/styles/reset.css ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "build:minify": "lightningcss --minify ./dist/styles/reset.css ./dist/styles/styles.css ./dist/styles/typography.css --output-dir ./dist/styles",
    "build:vanilla-components-css": "node ./scripts/task-merge-vanilla-components-css.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf node_modules dist build types .turbo",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "vitest"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/react.d.ts",
  "module": "./dist/react.js",
  "main": "./dist/react.js",
  "files": [
    "dist/",
    "src/"
  ],
  "exports": {
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "default": "./dist/astro.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "main": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./reset.css": {
      "import": "./dist/styles/reset.css",
      "default": "./dist/styles/reset.css"
    },
    "./styles.css": {
      "import": "./dist/styles/styles.css",
      "default": "./dist/styles/styles.css"
    },
    "./typography.css": {
      "import": "./dist/styles/typography.css",
      "default": "./dist/styles/typography.css"
    },
    "./components.css": {
      "import": "./dist/styles/components-vanilla.css",
      "default": "./dist/styles/components-vanilla.css"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "motion": "^12.40.0",
    "npm-run-all": "^4.1.5",
    "prism-react-renderer": "^2.4.1",
    "react-day-picker": "^10.0.1",
    "zod": "^4.4.3",
    "zod-form-data": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/node": "10.1.3",
    "@biomejs/biome": "2.4.16",
    "@rsbuild/plugin-react": "^2.0.1",
    "@rslib/core": "^0.22.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-links": "^10.4.2",
    "@storybook/addon-themes": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "astro": "6.4.4",
    "chokidar": "^5.0.0",
    "eslint-plugin-storybook": "^10.4.2",
    "lightningcss": "^1.32.0",
    "lightningcss-cli": "^1.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "storybook": "^10.4.2",
    "typescript": "6.0.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "files": [
      "dist/",
      "src/"
    ]
  }
}
