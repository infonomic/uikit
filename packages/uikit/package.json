{
  "name": "@infonomic/uikit",
  "private": false,
  "license": "MIT",
  "version": "5.16.0",
  "type": "module",
  "description": "Infonomic UI kit is a collection of reusable UI components and utilities for React and Astro.",
  "keywords": [
    "uikit",
    "design system"
  ],
  "homepage": "https://github.com/infonomic/uikit",
  "bugs": {
    "url": "https://github.com/infonomic/uikit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/uikit.git",
    "directory": "packages/uikit"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "skip:astro-compose": "node ./scripts/build-astro.js",
    "dev:css": "node ./scripts/task-watch-css.js",
    "skip:css": "lightningcss --sourcemap --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "dev:code": "rslib build --watch",
    "build": "run-s build:*",
    "build:clean": "rimraf dist build",
    "build:code": "rslib build",
    "build:astro": "node ./scripts/build-astro.js",
    "build:css": "lightningcss --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "build:minify": "lightningcss --minify ./dist/styles/styles.css ./dist/styles/typography.css --output-dir ./dist/styles",
    "build:vanilla-components-css": "node ./scripts/task-merge-vanilla-components-css.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf node_modules dist build types .turbo",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "vitest"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/react.d.ts",
  "module": "./dist/react.js",
  "main": "./dist/react.js",
  "files": [
    "dist/",
    "src/"
  ],
  "exports": {
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "default": "./dist/astro.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "main": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./styles.css": {
      "import": "./dist/styles/styles.css",
      "default": "./dist/styles/styles.css"
    },
    "./typography.css": {
      "import": "./dist/styles/typography.css",
      "default": "./dist/styles/typography.css"
    },
    "./components.css": {
      "import": "./dist/styles/components-vanilla.css",
      "default": "./dist/styles/components-vanilla.css"
    }
  },
  "dependencies": {
    "@mantine/hooks": "^8.3.10",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "material-ripple-effects": "^2.0.1",
    "motion": "^12.23.26",
    "npm-run-all": "^4.1.5",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.13.0",
    "zod": "^4.2.1",
    "zod-form-data": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/node": "9.5.1",
    "@biomejs/biome": "2.3.10",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rslib/core": "^0.19.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/addon-themes": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "astro": "5.16.6",
    "chokidar": "^5.0.0",
    "eslint-plugin-storybook": "^10.1.11",
    "lightningcss": "^1.30.2",
    "lightningcss-cli": "^1.30.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "^6.1.2",
    "storybook": "^10.1.11",
    "typescript": "5.9.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "access": "public",
    "files": [
      "dist/",
      "src/"
    ]
  }
}
