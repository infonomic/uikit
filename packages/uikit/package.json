{
  "name": "@infonomic/uikit",
  "private": false,
  "license": "MIT",
  "version": "2.7.0",
  "type": "module",
  "description": "Infonomic UI kit is a collection of reusable UI components and utilities for React and Astro.",
  "keywords": [
    "uikit",
    "design system"
  ],
  "homepage": "https://github.com/infonomic/uikit",
  "bugs": {
    "url": "https://github.com/infonomic/uikit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/uikit.git",
    "directory": "packages/uikit"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/react.d.ts",
  "module": "./dist/react.js",
  "main": "./dist/react.js",
  "files": [
    "dist/",
    "src/"
  ],
  "exports": {
    "./astro": {
      "types": "./src/astro.d.ts",
      "import": "./src/astro.js",
      "default": "./src/astro.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "main": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./styles.css": {
      "import": "./dist/styles/styles.css",
      "default": "./dist/styles/styles.css"
    },
    "./typography.css": {
      "import": "./dist/styles/typography.css",
      "default": "./dist/styles/typography.css"
    }
  },
  "scripts": {
    "dev": "run-p dev:*",
    "skip:astro-compose": "node ./scripts/build-astro.js",
    "dev:css": "node ./scripts/task-watch-css.js",
    "skip:css": "lightningcss --sourcemap --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "dev:code": "rslib build --watch",
    "build": "run-s build:*",
    "build:clean": "rimraf dist build",
    "build:code": "rslib build",
    "skip:astro": "astro check && astro build",
    "skip2:astro-compose": "node ./scripts/build-astro.js",
    "build:css": "lightningcss --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "skip:post-process-css": "node ./scripts/task-merge-css.js",
    "build:minify": "lightningcss --minify ./dist/styles/styles.css ./dist/styles/typography.css --output-dir ./dist/styles",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf node_modules dist build types .turbo",
    "lint": "biome check . --diagnostic-level=warn",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "vitest"
  },
  "dependencies": {
    "@mantine/hooks": "^8.2.5",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.3",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "material-ripple-effects": "^2.0.1",
    "motion": "^12.23.12",
    "npm-run-all": "^4.1.5",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.3",
    "react": "19.1.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.1.1",
    "zod": "^4.0.17",
    "zod-form-data": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/node": "9.4.2",
    "@biomejs/biome": "2.2.0",
    "@rsbuild/plugin-react": "^1.3.5",
    "@rslib/core": "^0.12.2",
    "@storybook/addon-a11y": "^9.1.3",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/addon-links": "^9.1.3",
    "@storybook/addon-themes": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "astro": "5.13.2",
    "chokidar": "^4.0.3",
    "eslint-plugin-storybook": "^9.1.3",
    "lightningcss": "^1.30.1",
    "lightningcss-cli": "^1.30.1",
    "rimraf": "^6.0.1",
    "storybook": "^9.1.3",
    "typescript": "5.9.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "files": [
      "dist/",
      "src/"
    ]
  }
}
