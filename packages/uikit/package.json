{
  "name": "@infonomic/uikit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "types": "./dist/react/index.d.ts",
  "module": "./dist/react/index.js",
  "main": "./dist/react/index.js",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./styles.css": {
      "import": "./dist/styles/styles.css"
    },
    "./typography.css": {
      "import": "./dist/styles/typography.css"
    }
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:css": "lightningcss --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "dev:code": "rslib build --watch",
    "build": "run-s build:*",
    "build:clean": "rm -rf dist",
    "build:code": "rslib build",
    "build:css": "lightningcss --bundle ./src/styles/styles.css ./src/styles/typography.css --output-dir ./dist/styles",
    "skip:post-process-css": "node ./post-build-merge-css.js",
    "build:minify": "lightningcss --minify ./dist/styles/styles.css ./dist/styles/typography.css --output-dir ./dist/styles",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules dist types .turbo",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx ./src",
    "lint:fix": "eslint --fix --ext .ts,.tsx,.js,.jsx ./src",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "vitest"
  },
  "dependencies": {
    "@mantine/hooks": "^7.17.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.1.2",
    "classnames": "^2.5.1",
    "material-ripple-effects": "^2.0.1",
    "motion": "^12.4.7",
    "npm-run-all": "^4.1.5",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zod-form-data": "^2.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@rsbuild/plugin-react": "^1.1.1",
    "@rslib/core": "^0.4.1",
    "@storybook/addon-a11y": "^8.5.8",
    "@storybook/addon-essentials": "^8.5.8",
    "@storybook/addon-interactions": "^8.5.8",
    "@storybook/addon-links": "^8.5.8",
    "@storybook/addon-themes": "^8.5.8",
    "@storybook/blocks": "^8.5.8",
    "@storybook/react": "^8.5.8",
    "@storybook/react-vite": "^8.5.8",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.13.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-plugin-storybook": "^0.11.3",
    "lightningcss-cli": "^1.29.1",
    "storybook": "^8.5.8",
    "typescript": "5.7.3",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}